<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--

  Based on Checkstyle's bundled sun_checks.xml (Sun coding conventions), tuned for this
  codebase. Checks that produced a large volume of low-value violations on the existing
  codebase have been disabled below with a rationale comment rather than deleted, so the
  original Sun intent stays visible.

  READ STATIC_ANALYSIS_POLICY.md (repo root) BEFORE ADDING OR REMOVING A RULE HERE. It holds the
  policy these decisions follow (which tool owns what, why formatting rules never belong in this
  file, why duplicating an active PMD rule is rejected) plus a register of every Checkstyle check
  already evaluated, its measured violation count, and the reason it was adopted or turned down -
  so a rule that was already considered does not get re-litigated from scratch.

-->

<module name="Checker">
  <property name="severity" value="error"/>

  <property name="fileExtensions" value="java, properties, xml"/>

  <!-- Excludes all 'module-info.java' files              -->
  <!-- See https://checkstyle.org/config_filefilters.html -->
  <module name="BeforeExecutionExclusionFileFilter">
    <property name="fileNamePattern" value="module\-info\.java$"/>
  </module>

  <!-- https://checkstyle.org/config_filters.html#SuppressionFilter -->
  <module name="SuppressionFilter">
    <property name="file" value="${org.checkstyle.sun.suppressionfilter.config}"
              default="checkstyle-suppressions.xml" />
    <property name="optional" value="true"/>
  </module>

  <!-- Checks that a package-info.java file exists for each package.     -->
  <!-- See https://checkstyle.org/config_javadoc.html#JavadocPackage -->
  <module name="JavadocPackage"/>

  <!-- Checks whether files end with a new line.                        -->
  <!-- See https://checkstyle.org/config_misc.html#NewlineAtEndOfFile -->
  <module name="NewlineAtEndOfFile"/>

  <!-- Checks that property files contain the same keys.         -->
  <!-- See https://checkstyle.org/config_misc.html#Translation -->
  <module name="Translation"/>

  <!-- Checks for Size Violations.                    -->
  <!-- See https://checkstyle.org/config_sizes.html -->
  <module name="FileLength"/>
  <module name="LineLength">
    <!-- Sun's default of 80 is a 1990s-era convention; 120 matches common modern practice. -->
    <property name="max" value="120"/>
    <property name="fileExtensions" value="java"/>
    <!--
      Exempts the continuation line of a `@see <a href="...">TEXT</a>` Javadoc link. The Eclipse
      formatter Spotless runs already wraps this tag onto two lines once the URL pushes it past the
      limit - `@see <a` on its own line, `href="...">TEXT</a>` on the next - because `@see`/`<a` are
      the only whitespace it's allowed to break on. What's left on the continuation line is a single
      unbreakable token (the URL plus its closing markup), so it cannot be shortened further.
      SpotBugsError's upstream links are all 123-182 characters (bugDescriptions.html anchors are
      full slugified section titles), so without this exemption every one of them is a violation
      Spotless's own formatting produces and cannot fix.

      Kept deliberately narrow rather than the usual "any line with no spaces" pattern: it matches
      only this specific continuation-line shape, so an over-long line of code or prose is still a
      violation.
    -->
    <property name="ignorePattern"
              value="^ *\* *href=&quot;https?://[^&quot; ]+&quot;&gt;[^ ]+&lt;/a&gt;$"/>
  </module>

  <!-- Checks for whitespace                               -->
  <!-- See https://checkstyle.org/config_whitespace.html -->
  <module name="FileTabCharacter"/>

  <!-- Miscellaneous other checks.                   -->
  <!-- See https://checkstyle.org/config_misc.html -->
  <module name="RegexpSingleline">
    <property name="format" value="\s+$"/>
    <property name="minimum" value="0"/>
    <property name="maximum" value="0"/>
    <property name="message" value="Line has trailing spaces."/>
  </module>

  <module name="TreeWalker">

    <!-- Checks for Javadoc comments.                     -->
    <!-- See https://checkstyle.org/config_javadoc.html -->
    <module name="InvalidJavadocPosition"/>
    <module name="JavadocMethod">
      <property name="validateThrows" value="true"/>
    </module>
    <module name="JavadocType"/>
    <!--
      Scoped to VARIABLE_DEF only (the sole token this Checkstyle version accepts for this
      check besides ENUM_CONSTANT_DEF) - the default token set also includes ENUM_CONSTANT_DEF,
      which would require a comment on every constant of every mapping enum (e.g.
      ResourceTypeMapping.DataCiteResourceType.AUDIOVISUAL("Audiovisual")) - the same
      "comment would just restate the name" problem this module was originally disabled for,
      just relocated from DTO fields to enum constants. serialVersionUID is exempted too: it's
      the canonical example in Checkstyle's own docs for this property, and a comment restating
      "serialization version identifier" on it would be equally pure noise.
    -->
    <module name="JavadocVariable">
      <property name="tokens" value="VARIABLE_DEF"/>
      <property name="ignoreNamePattern" value="^serialVersionUID$"/>
    </module>
    <!--
      JavadocStyle (this ruleset's Sun-baseline check for malformed HTML plus a
      period-terminated first sentence) was REMOVED in Checkstyle 14, so it had to go when the
      engine was pinned - see the checkstyle.version property in pom.xml for why that pin exists.
      The six checks below replace it. SummaryJavadoc is its nearest single successor and is the
      one that changed the codebase: it requires every Javadoc block to open with a prose summary
      sentence, and enabling it initially reported 56 violations, because the convention until
      then was tag-only Javadoc (a bare @param/@return block with no prose). All 56 were given a
      real summary rather than suppressed, so this is now an enforced house rule: a new
      @param/@return-only Javadoc block fails the build.

      What a summary must NOT be, to stay useful rather than restating the method name: the
      check's own default forbiddenSummaryFragments already rejects an opening "@return the ...",
      "This method returns ...", and "A {@code Foo} is a ...". Beyond that, describe what the
      member does or why it exists (the non-obvious behaviour - a fallback, a degradation, a
      routing decision), not its signature. See ManifestationDateSetters#addDateItem or
      XmlParsingUtils#parseDocument for the intended flavour.

      The other five were each measured at 0 violations on this codebase when added, so they
      encode existing practice rather than changing it.
      Genuinely lost, with no replacement adopted: JavadocStyle's malformed-HTML check.

      One thing NOT to infer from the ordering here: all six of these checks already shipped in
      Checkstyle 9.3 (the version maven-checkstyle-plugin defaults to, i.e. what this project ran
      before the pin - verified by listing the check classes in both jars). Enabling them was
      opportunistic, not something the newer engine made possible. The only change the bump forced
      is JavadocStyle's removal; the reason the pin exists at all is Java 21+ syntax support, not
      these Javadoc rules.
    -->
    <module name="SummaryJavadoc"/>
    <module name="NonEmptyAtclauseDescription"/>
    <module name="JavadocBlockTagLocation"/>
    <module name="JavadocMissingLeadingAsterisk"/>
    <module name="JavadocContentLocation"/>
    <module name="SingleLineJavadoc"/>
    <module name="MissingJavadocMethod"/>

    <!-- Checks for Naming Conventions.                  -->
    <!-- See https://checkstyle.org/config_naming.html -->
    <!--
      ClassTypeParameterName/InterfaceTypeParameterName/MethodTypeParameterName mirror SonarQube/
      SonarLint rule S119 ("Type parameter names should comply with a naming convention"), which
      IntelliJ's SonarLint flags locally but which had no build-time equivalent otherwise. Default
      pattern (^[A-Z][0-9]?$) matches Sonar's own default, so no propertyExpansion is needed.
    -->
    <module name="ClassTypeParameterName"/>
    <module name="InterfaceTypeParameterName"/>
    <module name="MethodTypeParameterName"/>
    <module name="ConstantName"/>
    <module name="LocalFinalVariableName"/>
    <module name="LocalVariableName"/>
    <module name="MemberName"/>
    <module name="MethodName">
      <!--
        Parameterized (rather than a plain default) so the src/test/java checkstyle execution
        in pom.xml can loosen this to allow the project's methodUnderTest_scenario_expectedResult
        test-naming convention via propertyExpansion, while src/main/java keeps the strict
        default pattern - see the two "checkstyle.methodname.format" propertyExpansion entries
        in the maven-checkstyle-plugin config.
      -->
      <property name="format" value="${checkstyle.methodname.format}"/>
    </module>
    <module name="PackageName"/>
    <module name="ParameterName"/>
    <module name="StaticVariableName"/>
    <module name="TypeName"/>

    <!-- Checks for imports                              -->
    <!-- See https://checkstyle.org/config_imports.html -->
    <module name="AvoidStarImport"/>
    <module name="IllegalImport"/> <!-- defaults to sun.* packages -->
    <module name="RedundantImport"/>
    <module name="UnusedImports">
      <property name="processJavadoc" value="false"/>
    </module>
    <!--
      Nothing enforced import order before, and the tree had drifted: some files led with
      org.skgif, others with java.util or com.fasterxml, with no rule to appeal to.

      Deliberately one flat alphabetical group (the `groups` property is left unset) rather than
      the java/jakarta/org/com grouping many styles use - the codebase never had blank-line import
      groups, so imposing them would be a far larger and more arbitrary diff than simply sorting
      what is there. option=top matches the test sources, which put their AssertJ/Mockito static
      imports first (87 of them; src/main/java has none).

      separated=true is what allows the conventional blank line between the static block and the
      rest; with the default (false) checkstyle rejects it as "Extra separation in import group",
      which would have meant stripping that blank line out of 40 test files for no benefit.

      Note this only reports; unlike spotless it never repairs. The initial sweep (16 files) was
      applied with a one-off script - safe because Java import order carries no semantics - but
      future drift has to be fixed by hand.
    -->
    <module name="ImportOrder">
      <property name="option" value="top"/>
      <property name="sortStaticImportsAlphabetically" value="true"/>
      <property name="separated" value="true"/>
    </module>

    <!-- Checks for Size Violations.                    -->
    <!-- See https://checkstyle.org/config_sizes.html -->
    <module name="MethodLength"/>
    <module name="ParameterNumber"/>

    <!-- Checks for whitespace                               -->
    <!-- See https://checkstyle.org/config_whitespace.html -->
    <module name="EmptyForIteratorPad"/>
    <module name="GenericWhitespace"/>
    <module name="MethodParamPad"/>
    <module name="NoWhitespaceAfter"/>
    <module name="NoWhitespaceBefore"/>
    <!--
      option=eol (rather than Checkstyle's own default of nl) matches intellij-style.xml's
      Standard-Indents formatter profile, which leaves wrap_before_*_operator=false - operators
      stay at the end of the line being wrapped, not the start of the continuation line.
    -->
    <module name="OperatorWrap">
      <property name="option" value="eol"/>
      <property name="tokens"
                value="QUESTION, COLON, EQUAL, NOT_EQUAL, DIV, PLUS, MINUS, STAR, MOD,
                       SR, BSR, GE, GT, SL, LE, LT, BXOR, BOR, LOR, BAND, LAND, LITERAL_INSTANCEOF"/>
    </module>
    <module name="ParenPad"/>
    <module name="TypecastParenPad"/>
    <module name="WhitespaceAfter"/>
    <module name="WhitespaceAround"/>

    <!-- Modifier Checks                                    -->
    <!-- See https://checkstyle.org/config_modifier.html -->
    <module name="ModifierOrder"/>
    <module name="RedundantModifier"/>

    <!-- Checks for blocks. You know, those {}'s         -->
    <!-- See https://checkstyle.org/config_blocks.html -->
    <module name="AvoidNestedBlocks"/>
    <module name="EmptyBlock"/>
    <module name="LeftCurly"/>
    <module name="NeedBraces"/>
    <module name="RightCurly"/>

    <!-- Checks for common coding problems               -->
    <!-- See https://checkstyle.org/config_coding.html -->
    <module name="EmptyStatement"/>
    <module name="EqualsHashCode"/>
    <!--
      Every violation found was the standard `this.x = x` constructor-parameter (or
      builder-setter) idiom, not a real shadowing bug in a method body - so those two
      idiomatic cases are excluded rather than renaming every constructor/setter
      parameter away from its field name.
    -->
    <module name="HiddenField">
      <property name="ignoreConstructorParameter" value="true"/>
      <property name="ignoreSetter" value="true"/>
    </module>
    <module name="IllegalInstantiation"/>
    <module name="InnerAssignment"/>
    <module name="MagicNumber"/>
    <module name="MissingSwitchDefault"/>
    <module name="MultipleVariableDeclarations"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>

    <!-- Checks for class design                         -->
    <!-- See https://checkstyle.org/config_design.html -->
    <!--
      DesignForExtension disabled: one of Sun's noisiest/most controversial checks in
      modern Java (also dropped by Google's checkstyle ruleset) - it doesn't reflect an
      intent to build subclassable frameworks in this codebase's mapper/DTO/resource code.
    -->
    <!-- <module name="DesignForExtension"/> -->

    <module name="FinalClass"/>
    <module name="HideUtilityClassConstructor"/>
    <module name="InterfaceIsType"/>

    <!--
      VisibilityModifier disabled: requiring every non-private field to be wrapped in
      accessors produced 201 violations, almost all in DTO classes whose fields are
      public specifically for Jackson JSON (de)serialization - adding getters/setters
      there is boilerplate with no safety benefit.
    -->
    <!-- <module name="VisibilityModifier"/> -->

    <!-- Miscellaneous other checks.                   -->
    <!-- See https://checkstyle.org/config_misc.html -->
    <module name="ArrayTypeStyle"/>
    <!--
      FinalParameters disabled: requiring every method/constructor parameter to be
      declared final produced 330 violations. Widely considered low-value churn (it
      doesn't prevent reassignment of fields/collections, only local parameter
      rebinding) and would touch nearly every method signature in the codebase.
    -->
    <!-- <module name="FinalParameters"/> -->
    <module name="TodoComment"/>
    <module name="UpperEll"/>

    <!-- https://checkstyle.org/config_filters.html#SuppressionXpathFilter -->
    <module name="SuppressionXpathFilter">
      <property name="file" value="${org.checkstyle.sun.suppressionxpathfilter.config}"
                default="checkstyle-xpath-suppressions.xml" />
      <property name="optional" value="true"/>
    </module>

    <!-- ================================================================ -->
    <!-- Checks beyond Sun's baseline - NOT part of the bundled            -->
    <!-- sun_checks.xml above this line. Added and triaged individually,   -->
    <!-- each with a real per-check violation count from this codebase.    -->
    <!-- ================================================================ -->
    <module name="CovariantEquals"/>
    <module name="EqualsAvoidNull"/>
    <module name="FallThrough"/>
    <!--
      IllegalCatch disabled: all 5 violations found were a deliberate degrade-gracefully
      pattern around unpredictable external calls (REST client fetches, third-party XML
      parsing) - catch (RuntimeException|Exception e) falling back to null/Optional.empty()/
      notFound(...) rather than crashing the request. None catch bare Throwable.
    -->
    <!-- <module name="IllegalCatch"/> -->
    <module name="OneStatementPerLine"/>
    <module name="StringLiteralEquality"/>
    <module name="UnnecessaryParentheses"/>
    <module name="UnusedLocalVariable"/>
    <!--
      lineWrappingIndentation is set explicitly (rather than left at Checkstyle's own default)
      because intellij-style.xml's continuation_indentation=2, combined with
      indentation.size=4, produces an 8-space continuation indent - the "Standard Indents"
      wrapping this codebase's formatter profile uses throughout. forceStrictCondition=false
      relaxes column-alignment checking for lines Eclipse/IntelliJ wraps on its own, since this
      profile no longer forces column alignment (alignment_for_*=0) the way e27ff78 briefly did.
    -->
    <module name="Indentation">
      <property name="basicOffset" value="4"/>
      <property name="braceAdjustment" value="0"/>
      <property name="caseIndent" value="4"/>
      <property name="throwsIndent" value="8"/>
      <property name="lineWrappingIndentation" value="8"/>
      <property name="arrayInitIndent" value="4"/>
      <property name="forceStrictCondition" value="false"/>
    </module>
    <!--
      Net-new (Sun's baseline has no AnnotationLocation check): mirrors intellij-style.xml's
      alignment_for_annotations_on_{type,field,method}=49 (own line required). A second module
      for parameter/local-variable annotations (matching alignment_for_annotations_on_
      {parameter,local_variable}=0, "same line allowed") isn't possible - AnnotationLocation's
      acceptable tokens are only CLASS_DEF/INTERFACE_DEF/ENUM_DEF/METHOD_DEF/CTOR_DEF/
      VARIABLE_DEF/RECORD_DEF/COMPACT_CTOR_DEF; it has no way to check PARAMETER_DEF or
      distinguish local variables from VARIABLE_DEF fields. Left unchecked, which matches the
      "0 = no constraint" intent for those two settings anyway.
    -->
    <module name="AnnotationLocation">
      <property name="id" value="AnnotationLocationMostCases"/>
      <property name="tokens"
                value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, METHOD_DEF, CTOR_DEF, VARIABLE_DEF,
                       RECORD_DEF, COMPACT_CTOR_DEF"/>
      <property name="allowSamelineMultipleAnnotations" value="false"/>
      <property name="allowSamelineSingleParameterlessAnnotation" value="false"/>
      <property name="allowSamelineParameterizedAnnotation" value="false"/>
    </module>


    <!-- ================================================================ -->
    <!-- Java 21-25 idiom enforcement.                                     -->
    <!--                                                                  -->
    <!-- All of these ship only in a Checkstyle newer than the 9.3 the     -->
    <!-- maven-checkstyle-plugin defaults to, so they became available     -->
    <!-- with the checkstyle.version pin in pom.xml (see that property's   -->
    <!-- comment). None has a PMD equivalent - PMD 7.17 has no rule that   -->
    <!-- requires JEP 456 unnamed variables at all - so there is no        -->
    <!-- duplication to weigh here, unlike most of this file.              -->
    <!--                                                                  -->
    <!-- Why these and not the rest: this codebase already uses records,   -->
    <!-- virtual threads, switch expressions, sequenced collections and    -->
    <!-- record patterns, but nothing enforced that. These checks make the -->
    <!-- style self-enforcing rather than dependent on review catching it: -->
    <!-- UnusedCatchParameterShouldBeUnnamed found 7 discarded exception   -->
    <!-- parameters and UnusedLambdaParameterShouldBeUnnamed 15 ignored    -->
    <!-- lambda parameters that a manual pass had already missed. The rest  -->
    <!-- measured 0 and are adopted as regression guards - notably          -->
    <!-- SealedShouldHavePermitsList, which has nothing to check today     -->
    <!-- (no sealed types) but will the moment one is introduced.          -->
    <!-- ================================================================ -->
    <module name="UnusedCatchParameterShouldBeUnnamed"/>
    <module name="UnusedLambdaParameterShouldBeUnnamed"/>
    <module name="UnusedTryResourceShouldBeUnnamed"/>
    <!--
      Scope limit found by negative-testing rather than assuming: this fires on a simple variable
      receiver (`x != null && x instanceof Foo`) but NOT on a method-call one
      (`a.b() != null && a.b() instanceof Foo`), which is the shape that actually occurred here
      before JsonLdContextBase#clientId was rewritten. So it guards the common case only - do not
      read a green build as proof that no redundant null check exists.
    -->
    <module name="UnnecessaryNullCheckWithInstanceOf"/>
    <module name="UnnecessaryTypeArgumentsWithRecordPattern"/>
    <module name="PatternVariableAssignment"/>
    <module name="PatternVariableName"/>
    <module name="MissingNullCaseInSwitch"/>
    <module name="WhenShouldBeUsed"/>
    <module name="UseEnhancedSwitch"/>
    <module name="SealedShouldHavePermitsList"/>
    <module name="MissingOverrideOnRecordAccessor"/>
    <module name="RecordComponentName"/>
    <module name="RecordTypeParameterName"/>
    <module name="LambdaParameterName"/>
    <module name="CatchParameterName"/>

    <!-- ================================================================ -->
    <!-- Semantic gaps PMD does not cover, each measured at 0 violations   -->
    <!-- on both source roots when added, so they encode existing practice -->
    <!-- and act as regression guards rather than demanding any cleanup.   -->
    <!-- PMD's naming/semicolon/import rules all live in codestyle.xml,    -->
    <!-- which pmd-ruleset.xml deliberately does not include (see its      -->
    <!-- description) - so these overlap nothing.                          -->
    <!--                                                                  -->
    <!-- NOT added, though also at 0: ArrayTrailingComma. It is the direct -->
    <!-- inverse of NoArrayTrailingComma below (one demands a trailing     -->
    <!-- comma in an array initializer, the other forbids it). Both read 0 -->
    <!-- only because the codebase currently has no multi-line array       -->
    <!-- initializer at all; enabling both would contradict the moment one -->
    <!-- is written. NoArrayTrailingComma is the one kept, to match        -->
    <!-- NoEnumTrailingComma.                                              -->
    <!-- ================================================================ -->
    <module name="MutableException"/>
    <module name="AvoidNoArgumentSuperConstructorCall"/>
    <module name="NoClone"/>
    <module name="NoFinalizer"/>
    <module name="NoCodeInFile"/>
    <module name="OneTopLevelClass"/>
    <module name="OuterTypeFilename"/>
    <module name="OuterTypeNumber"/>
    <module name="PackageDeclaration"/>
    <module name="PackageAnnotation"/>
    <module name="MissingDeprecated"/>
    <module name="AnnotationUseStyle"/>
    <module name="OverloadMethodsDeclarationOrder"/>
    <module name="ConstructorsDeclarationGrouping"/>
    <module name="AbbreviationAsWordInName"/>
    <module name="IllegalIdentifierName"/>
    <module name="HexLiteralCase"/>
    <module name="NoEnumTrailingComma"/>
    <module name="NoArrayTrailingComma"/>
    <module name="UnnecessarySemicolonAfterOuterTypeDeclaration"/>
    <module name="UnnecessarySemicolonAfterTypeMemberDeclaration"/>
    <module name="UnnecessarySemicolonInEnumeration"/>
    <module name="UnnecessarySemicolonInTryWithResources"/>
    <module name="AvoidEscapedUnicodeCharacters"/>
    <module name="NestedForDepth"/>
    <module name="NestedTryDepth"/>
    <module name="ThrowsCount"/>
    <module name="AnonInnerLength"/>
    <!--
      Not free like the rest of this block - 2 sites were fixed to adopt it:
      CrossrefBiblioMapper's venueFromXmlMetadata and JsonLdEnvelopes' envelope each declared a
      local several statements before its first use. Kept because "declare next to first use" is
      a real readability rule with no PMD equivalent active here (PMD's PrematureDeclaration
      lives in the excluded codestyle.xml).
    -->
    <module name="VariableDeclarationUsageDistance"/>

    <!--
      Javadoc structure checks, same 0-violation basis. These complement the
      SummaryJavadoc block above: that one governs whether a summary exists, these govern how
      the rest of the block is written (tag order, paragraph markup, tag continuation indent).
    -->
    <module name="AtclauseOrder"/>
    <module name="RequireEmptyLineBeforeBlockTagGroup"/>
    <module name="IllegalBlockTag"/>
    <module name="JavadocMissingWhitespaceAfterAsterisk"/>
    <module name="JavadocParagraph"/>
    <module name="JavadocTagContinuationIndentation"/>
    <!-- Fixed 6 sites to adopt: raw &amp;gt;/&amp;lt; HTML entities in Javadoc prose replaced with
         {@code ...} spans, which read better in source and render identically. -->
    <module name="PreferLiteralJavadocInlineTag"/>
    <module name="MissingJavadocPackage"/>
    <!--
      Not free either - 33 public types (almost all Crossref/DataCite Jackson DTOs, plus the two
      REST client interfaces and UnsupportedFilterException) had no type Javadoc. Each was given a
      one-line summary naming the provider field it mirrors, which is the useful thing to say about
      a DTO and is not derivable from the record name alone. Completes the pairing with
      SummaryJavadoc above: that governs members, this governs the types holding them.
    -->
    <module name="MissingJavadocType"/>
  </module>

</module>

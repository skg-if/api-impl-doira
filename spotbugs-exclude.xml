<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclude filter - kept deliberately minimal. Every rejection that can be attached to a
  specific class/method now lives as a @SuppressFBWarnings annotation in source (or a package-info.java
  package-level annotation for a whole DTO package) instead of a <Match> here - see
  STATIC_ANALYSIS_POLICY.md's SpotBugs decision register for the full reasoning behind each one.

  This file now covers only what CANNOT carry an annotation:
-->
<FindBugsFilter>
  <!--
    Whole-package exclusion: org.skgif.doi.generated.* is openapi-generator output, regenerated on
    every build - hand-added annotations here would be silently wiped on the next generator run,
    the same reason maven-pmd-plugin's excludeRoots and jacoco-maven-plugin's excludes skip this
    exact package. Matched by class, not by bug pattern, so a future openapi-generator bump
    tripping a different detector on this generated code doesn't need a new entry before the build
    goes green again.
  -->
  <Match>
    <Class name="~org\.skgif\.doi\.generated\..*"/>
  </Match>
</FindBugsFilter>

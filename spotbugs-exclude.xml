<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclude filter - see STATIC_ANALYSIS_POLICY.md's "SpotBugs decision register" for the
  measured count and reasoning behind every <Match> below. Each entry documents a rejection, the
  same discipline pmd-ruleset.xml/pmd-ruleset-tests.xml already use for their own exclusions -
  never add a <Match> here without a matching register row.
-->
<FindBugsFilter>
  <!--
    469 hits (96% of an unfiltered run), almost entirely on OpenAPI-generated model getters/
    constructors and JSON-deserialized provider DTOs (CrossrefWork, DataCiteAttributes, ...).
    These are plain data carriers with no independent mutation path once deserialized; defensive
    copying every List/Map getter and constructor across ~30 DTO classes would be pure churn for
    no real safety gain here.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!--
    9 hits (8 BC_VACUOUS_INSTANCEOF + 1 SIO_SUPERFLUOUS_INSTANCEOF), every one on a Java 21+
    record deconstruction pattern - e.g. CrossrefGrantMapper#website's
    `work.resource() instanceof CrossrefResource(Primary(String url))`. Record patterns require
    naming the type at every nesting level even when it's statically redundant with the accessor's
    return type; SpotBugs's bytecode-level check doesn't recognize the JEP 440/441 pattern
    desugaring and reads the resulting instanceof as vacuous/superfluous. This is a systemic style
    throughout the mappers (CrossrefJournalDoiResolver, CrossrefGrantMapper, ResourceTypeMapping,
    JsonLdContextBase), so a whole-codebase exclusion is used rather than per-site matches that
    would just multiply with every future record pattern.
  -->
  <Match>
    <Bug pattern="BC_VACUOUS_INSTANCEOF,SIO_SUPERFLUOUS_INSTANCEOF"/>
  </Match>

  <!--
    6 hits, all Path.getFileName() calls in the doc-consistency tests (GoldenFixtureConsistencyTest,
    MappingDocConsistencyTest, ToolchainVersionConsistencyTest) on paths sourced from Files.list/
    Files.walk over a known directory, or resolve()'d against one - never a root path, so
    getFileName() can never actually return null here even though the JDK contract allows it in
    general.
  -->
  <Match>
    <Class name="~org\.skgif\.doi\.docs\..*"/>
    <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
  </Match>

  <!--
    4 hits (2 call sites, reported twice each) on the two deliberate `catch (Exception _)`
    degrade-gracefully blocks that checkstyle.xml's IllegalCatch exclusion already documents (5
    violations there, same rationale) - malformed/unexpected upstream XML degrades to a
    REST-JSON-only result rather than failing the whole product response.
  -->
  <Match>
    <Class name="org.skgif.doi.crossref.xml.CrossrefVenueMetadataXmlParser"/>
    <Bug pattern="REC_CATCH_EXCEPTION"/>
  </Match>
  <Match>
    <Class name="org.skgif.doi.medra.xml.MedraOnixXmlParser"/>
    <Bug pattern="REC_CATCH_EXCEPTION"/>
  </Match>

  <!--
    Whole-package exclusion, not bug-pattern-scoped: org.skgif.doi.generated.model.* is
    openapi-generator output, not hand-written - same "generated code doesn't get the same
    scrutiny" precedent as maven-pmd-plugin's excludeRoots and jacoco-maven-plugin's excludes for
    this exact package. The only pattern this package tripped in the 2026-08-25 unfiltered run was
    1 SE_NO_SERIALVERSIONID hit (on JsonLdCtxBaseOrMore), already covered by the EI_EXPOSE_REP/REP2
    match above too - but matching the whole class rather than that one pattern means a future
    openapi-generator bump tripping a *different* detector on this generated code doesn't need a
    new register row before the build goes green again.
  -->
  <Match>
    <Class name="~org\.skgif\.doi\.generated\.model\..*"/>
  </Match>

  <!--
    1 hit, on ResourceTypeMapping#isAward's
    `attributes.types() instanceof DataCiteAttributes.Types(String resourceTypeGeneral, _)`. The
    "dead store" SpotBugs sees is the unnamed pattern variable `_` - the language's own marker for
    an intentionally discarded component, not an accidentally unused value.
  -->
  <Match>
    <Class name="org.skgif.doi.datacite.ResourceTypeMapping"/>
    <Method name="isAward"/>
    <Bug pattern="DLS_DEAD_LOCAL_STORE"/>
  </Match>
</FindBugsFilter>

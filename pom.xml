<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.skgif.doi</groupId>
  <artifactId>puma-skg-if-api</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.version>3.39.1</quarkus.platform.version>
    <openapi-generator-plugin.version>7.24.0</openapi-generator-plugin.version>
    <jackson-databind-nullable.version>0.2.11</jackson-databind-nullable.version>
    <surefire-plugin.version>3.5.6</surefire-plugin.version>
    <jacoco-plugin.version>0.8.15</jacoco-plugin.version>
    <build-helper-plugin.version>3.6.1</build-helper-plugin.version>
    <spotless-plugin.version>3.10.0</spotless-plugin.version>
    <pmd-plugin.version>3.28.0</pmd-plugin.version>
    <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
    <spotbugs-plugin.version>4.10.4.0</spotbugs-plugin.version>
    <!--
      Declared here only because spotbugs-maven-plugin's own <configuration><plugins> block below
      needs a version. Dependabot's maven ecosystem tracks <dependencies>/<build><plugins> GAVs,
      not an arbitrary plugin's nested <configuration> body, so this property will never get an
      automated bump PR like every other *.version property here - same class of blind spot as
      Dockerfile.jvm's literal JDK tag (see .github/dependabot.yml). Re-check
      https://central.sonatype.com/artifact/com.h3xstream.findsecbugs/findsecbugs-plugin manually.
    -->
    <findsecbugs-plugin.version>1.14.0</findsecbugs-plugin.version>
    <!-- Matches spotbugs-plugin.version's core analysis engine (4.10.4.0 wraps spotbugs 4.10.4). -->
    <spotbugs-annotations.version>4.10.4</spotbugs-annotations.version>
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <error-prone.version>2.50.0</error-prone.version>
    <error-prone-support.version>0.30.0</error-prone-support.version>
    <nullaway.version>0.14.0</nullaway.version>
    <jspecify.version>1.0.0</jspecify.version>
    <!--
      NullAway's severity, indirected through a property purely so a discovery run can lower it
      from the command line: `-Dnullaway.severity=WARN -Dmaven.compiler.failOnWarning=false`.
      -Dmaven.compiler.compilerArgs cannot do this - it does not override a <compilerArgs> list
      declared in the POM (confirmed empirically: the findings still came out at ERROR), so
      without this property there is no way to run a non-aborting discovery pass short of editing
      the POM. See the maven-compiler-plugin block below for why that matters.
    -->
    <nullaway.severity>ERROR</nullaway.severity>
    <!--
      Error Prone's/javac's warnings-are-fatal gate (see maven-compiler-plugin below), indirected
      for the same reason as nullaway.severity above: an explicit <failOnWarning>true</> in the
      plugin config takes precedence over the plugin's own ${maven.compiler.failOnWarning}
      expression, so a bare -Dmaven.compiler.failOnWarning=false is silently ignored (confirmed
      empirically: the build still failed with "warnings found and -Werror specified"). Routing
      the config through this property is what makes that override actually work. Stays true for
      every normal build; only a discovery run lowers it.
    -->
    <maven.compiler.failOnWarning>true</maven.compiler.failOnWarning>
    <!--
      Subpackages of org.skgif.doi that NullAway must NOT treat as annotated. Matching is by
      prefix, so this one entry covers both generated packages (org.skgif.doi.generated.api and
      .model). It is required, not cosmetic: AnnotatedPackages=org.skgif.doi below prefix-matches
      the generated openapi output too, and openapi-generator emits no nullness annotations at all,
      which makes every `builder.setX(foo.orElse(null))` call a finding. Measured while wiring this
      up: adding the exclusion removed 7 of 14 findings in CrossrefToSkgIfMapper alone.

      A property rather than a literal so a big new package can be staged in: temporarily append it
      here from the command line, fix its findings, then drop it again -
      `-Dnullaway.unannotated=org.skgif.doi.generated,org.skgif.doi.<new>`. Prefix matching only
      cascades downward, so excluding a child package does not exclude its parent.
    -->
    <nullaway.unannotated>org.skgif.doi.generated</nullaway.unannotated>
    <!--
      Checkstyle engine version, pinned independently of maven-checkstyle-plugin above.
      That plugin hardcodes a default engine of 9.3 (Jan 2022, a Java-17-era grammar),
      which cannot parse Java 21+ record patterns, guarded case labels, or the unnamed
      variable _ - those come out as parse errors, not violations. The plugin itself is
      already at its own latest (3.6.0), so the engine has to be overridden via a
      dependencies block on the plugin rather than by bumping the plugin.
    -->
    <checkstyle.version>14.0.0</checkstyle.version>
    <assertj.version>3.27.7</assertj.version>
    <archunit.version>1.5.0</archunit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-openapi</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
      <version>${jackson-databind-nullable.version}</version>
    </dependency>
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>
    <!--
      Nullness annotations (@NullMarked/@Nullable) for NullAway - see the maven-compiler-plugin
      block below and STATIC_ANALYSIS_POLICY.md's NullAway section. Declared explicitly even
      though junit-jupiter-api already drags it in transitively: that path is test-scoped, and
      main source must not rely on a test transitive for annotations it references.

      JSpecify rather than JSR-305's javax.annotation.Nullable, which is not on this project's
      compile classpath at all (confirmed: "package javax.annotation does not exist") and comes
      from a JSR abandoned unratified in 2012 that squats a javax.* namespace it does not own.
    -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
    </dependency>

    <!--
      @SuppressFBWarnings, used in place of spotbugs-exclude.xml <Match> entries wherever a
      rejection is scoped to a specific class/method - see STATIC_ANALYSIS_POLICY.md's SpotBugs
      decision register. CLASS retention (the annotation only needs to be visible to SpotBugs'
      own bytecode analysis, not at runtime), so provided rather than compile scope.
    -->
    <dependency>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-annotations</artifactId>
      <version>${spotbugs-annotations.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit-mockito</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!--
          No explicit maven-compiler-plugin block existed before this - the build relied on
          whatever version ships with the pinned Maven wrapper. Made explicit now because Error
          Prone needs to hook into javac via compilerArgs/annotationProcessorPaths, and every
          other plugin here already pins its version explicitly.

          Error Prone runs in-process (no fork=true), so it shares the JVM that runs Maven
          itself. That JVM needs the add-exports/add-opens flags Error Prone requires on
          JDK 16+ to reach into com.sun.tools.javac.* internals - those live in .mvn/jvm.config,
          not here, because compilerArgs only reaches a forked javac process. Don't add a comment
          line to that file itself: it has no comment syntax, every line is passed to the JVM
          launcher verbatim, and a "#..." line fails the build with "Could not find or load main
          class #" (confirmed empirically) - explain changes to it here instead.

          Its
          ERROR-severity default checks already fail the build (a compile error), same effect as
          the failOnViolation=true gates below. failOnWarning=true below closes the remaining gap
          for its WARNING-severity checks: unlike javac's own -Werror (which Error Prone's issue
          tracker documents as not reliably catching its diagnostics - google/error-prone#614),
          failOnWarning is enforced at the Maven plugin layer against every diagnostic the shared
          javax.tools compiler API reports, Error-Prone-sourced or not - confirmed by a negative
          test (see STATIC_ANALYSIS_POLICY.md's Error Prone section) that a reintroduced
          WARNING-severity finding fails test-compile.

          -XepExcludedPaths exempts the openapi-generator output under target/generated-sources,
          mirroring the same "generated code doesn't get the same scrutiny" precedent already
          applied via maven-pmd-plugin's excludeRoots, jacoco-maven-plugin's excludes and
          SpotBugs's whole-package match below. -XepDisableWarningsInGeneratedCode is kept too as
          a second, narrower layer (it recognizes the @jakarta.annotation.Generated annotation
          openapi-generator already emits) - the path exclusion covers ERROR-severity findings,
          which the annotation-based flag alone would not suppress.

          Not gated by ${skipTests} like the other four tools: Error Prone runs during compile, a
          phase -DskipTests never skips (that flag only skips test execution), so there is no
          equivalent lever here and none is being invented.

          ERROR PRONE SUPPORT (Picnic, tech.picnic.error-prone-support) adds ~100 extra
          @BugPattern checks via error-prone-contrib plus Refaster template rewrites via
          refaster-runner. 0.30.0 is built against Error Prone 2.50.0, so the two versions must
          move together. -XDaddTypeAnnotationsToSymbol=true above is required by it on JDK 21+.

          Nearly all of its checks ship at SUGGESTION severity, which javac reports as notes -
          invisible to failOnWarning, so without -XepAllSuggestionsAsWarnings adopting the library
          would enforce almost nothing and the cleanup it motivated would silently regress. That
          flag is what makes those checks blocking; the three -Xep:...:OFF / NamePattern exclusions
          below are what keep it from blocking on things this project cannot or should not adopt.
          The trade-off is that an error-prone-support bump introducing a new SUGGESTION check
          fails the build until it is triaged - intended, and the same bargain failOnWarning
          already makes.

          RequireExplicitNullMarking is turned OFF because it is NullAway's, not Picnic's, and only
          becomes visible under -XepAllSuggestionsAsWarnings: it demands @NullMarked on all 150
          top-level classes, which is precisely the per-package annotation scheme the NullAway
          section of STATIC_ANALYSIS_POLICY.md records as deliberately abandoned in favour of the
          AnnotatedPackages prefix flag. Enabling it would re-litigate a settled decision.

          LexicographicalAnnotationAttributeListing is turned OFF (3 findings, all in the
          *ProductsResource @Parameter(examples = {...}) arrays). Sorting those attributes gains
          nothing semantically and makes spotless reflow a readable multi-line @ExampleObject array
          into a deeply-indented cascade that then breaks checkstyle's 120-char LineLength - a gate
          deadlock with no formatting config that resolves it, since spotless owns formatting and
          never yields to checkstyle.

          Refaster's NamePattern is a DENY-list (negative lookahead), not an allow-list, so new
          rule families in a future release apply automatically and only the known-bad ones stay
          out. Excluded families, each measured:
            - Immutable{List,Map,Set}Rules / PreconditionsRules (90 findings): these do not fire on
              existing Guava usage - they rewrite JDK List.of()/Map.of() INTO Guava, which would
              force com.google.guava onto a project that has no Guava dependency at all. Applying
              them broke compilation in 29 files.
            - NullRules (21): requireNonNullElseGet(work.title(), List::of) infers T as
              "capture of ? extends Object" rather than List<String>, so every downstream member
              access fails. Applying it produced 82 compile errors.
            - StreamRules (4): reordering .map(f).findFirst() to .findFirst().map(f) is behaviour-
              preserving but costs NullAway provability - it models Optional.map strictly and
              Stream.map not at all, so the rewrite turned 3 clean sites into NullAway findings.
            - OptionalRules.RefasterEmitComment* (2): this rule injects a comment into source.
          A matching-nothing NamePattern silently disables Refaster entirely rather than erroring,
          which is indistinguishable from a green build - so this pattern is negative-tested (see
          STATIC_ANALYSIS_POLICY.md) in BOTH directions: an allowed rule must fail the build, and a
          denied one must not fire.

          NULLAWAY rides on the same Error Prone plugin as an extra check, and is one of the places
          a -Xep:Check:SEVERITY override is used deliberately: NullAway ships with
          a default severity of WARNING, and while failOnWarning=true would already make that
          blocking, -Xep:NullAway:ERROR is NullAway's own documented setup and keeps this gate
          independent of that flag.

          AnnotatedPackages=org.skgif.doi scopes it, and matching is by PREFIX, so that one entry
          covers the whole tree - both source roots, every subpackage, and anything added later. An
          earlier iteration instead used OnlyNullMarked=true with @NullMarked on each
          package-info.java; that was dropped once the whole tree was covered, because it needed 19
          annotations kept in sync and left a newly-added package silently UNCHECKED until someone
          remembered to mark it. The prefix flag fails safe instead. The two are mutually exclusive
          - passing both is an error. Nothing under src/ carries @NullMarked any more; the
          ${nullaway.unannotated} property above is the only scoping lever.

          JSpecifyMode is deliberately NOT set. That flag turns on deep generic-type nullness
          checking (nullness of type arguments, wildcards) and is documented as still under
          development with known false positives. Standard mode - top-level nullability only - is
          what this build relies on. A consequence worth knowing: annotating an inner type argument,
          e.g. List<@Nullable String>, is documentation the tool will not act on.

          -Xmaxerrs/-Xmaxwarns are raised from javac's default of 100 deliberately, and this is not
          cosmetic. That default silently TRUNCATES the diagnostic list: a discovery pass over this
          codebase reported exactly 100 test-phase findings twice in a row, which read as a real
          measurement rather than a cap, and hid a whole test file's worth of findings. Any count
          taken with the default cap in place is a lower bound, not a total.

          When bringing a new package or a batch of annotations in, run the discovery pass with

            -Dnullaway.severity=WARN -Dmaven.compiler.failOnWarning=false

          and NOT at the default ERROR. At ERROR javac aborts inside default-compile, so
          test-compile never runs and every finding in later sources is silently hidden - the exact
          trap that made an earlier discovery run under-report its own scope by an unknown margin.
          Note that -Dmaven.compiler.compilerArgs=... does NOT work for this: it does not override
          a <compilerArgs> list declared here, which is why the severity is a property.

          ExcludedFieldAnnotations exempts framework-initialised fields from the
          field-initialization check. The rest.* resources declare their config as non-final
          @ConfigProperty fields with no initializer, and tests use @InjectMock the same way; the
          container populates both before any use. This is an initialisation exemption, NOT a claim
          that those fields are nullable.
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <failOnWarning>${maven.compiler.failOnWarning}</failOnWarning>
          <compilerArgs>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <arg>-Xmaxerrs</arg>
            <arg>2000</arg>
            <arg>-Xmaxwarns</arg>
            <arg>2000</arg>
            <arg>-Xplugin:ErrorProne -XepAllSuggestionsAsWarnings -Xep:RequireExplicitNullMarking:OFF -Xep:LexicographicalAnnotationAttributeListing:OFF -XepOpt:Refaster:NamePattern=(?!(ImmutableListRules|ImmutableMapRules|ImmutableSetRules|PreconditionsRules|NullRules|StreamRules|OptionalRules.RefasterEmitComment)).* -XepDisableWarningsInGeneratedCode -XepExcludedPaths:.*/generated-sources/.* -Xep:NullAway:${nullaway.severity} -XepOpt:NullAway:AnnotatedPackages=org.skgif.doi -XepOpt:NullAway:UnannotatedSubPackages=${nullaway.unannotated} -XepOpt:NullAway:ExcludedFieldAnnotations=org.eclipse.microprofile.config.inject.ConfigProperty,jakarta.inject.Inject,org.eclipse.microprofile.rest.client.inject.RestClient,io.quarkus.test.InjectMock</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${error-prone.version}</version>
            </path>
            <path>
              <groupId>tech.picnic.error-prone-support</groupId>
              <artifactId>error-prone-contrib</artifactId>
              <version>${error-prone-support.version}</version>
            </path>
            <path>
              <groupId>tech.picnic.error-prone-support</groupId>
              <artifactId>refaster-runner</artifactId>
              <version>${error-prone-support.version}</version>
            </path>
            <path>
              <groupId>com.uber.nullaway</groupId>
              <artifactId>nullaway</artifactId>
              <version>${nullaway.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator-plugin.version}</version>
        <executions>
          <execution>
            <id>generate-skgif-models</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>src/main/openapi/skg-if-openapi.yaml</inputSpec>
              <generatorName>jaxrs-spec</generatorName>
              <library>quarkus</library>
              <generateApis>true</generateApis>
              <generateModelTests>false</generateModelTests>
              <generateApiTests>false</generateApiTests>
              <apiPackage>org.skgif.doi.generated.api</apiPackage>
              <modelPackage>org.skgif.doi.generated.model</modelPackage>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useTags>true</useTags>
                <useJakartaEe>true</useJakartaEe>
                <useOneOfInterfaces>true</useOneOfInterfaces>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>${build-helper-plugin.version}</version>
        <executions>
          <execution>
            <id>add-openapi-generated-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.build.directory}/generated-sources/openapi/src/gen/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire-plugin.version}</version>
        <configuration>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-plugin.version}</version>
        <configuration>
          <skip>${skipTests}</skip>
          <excludes>
            <!-- OpenAPI-generated DTOs (getters/setters/builders/equals/hashCode) - not
                 hand-written, so coverage on them isn't meaningful. -->
            <exclude>org/skgif/doi/generated/model/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!--
          Bound to process-sources, goal check, positioned (via declaration order - Maven runs
          same-phase executions in POM order) before maven-checkstyle-plugin's javadoc-tag-check
          below, also bound to process-sources - so a formatting failure is reported before
          style-rule failures. maven-pmd-plugin runs later still (process-classes, see the comment
          on its execution for why), which keeps the same formatting-first ordering.
          Gated by skip=${skipTests} like those sibling plugins, so it runs
          whenever `mvn test`/`package` would run tests and is skipped by `-DskipTests` (and by
          extension by CI's notest/skiptest commit-message flag - see CLAUDE.md's "Java code
          style" section).

          This is a hard gate (check, not apply): it fails the build on formatting drift instead
          of silently rewriting source files. On-demand fixes are still available via
          `mvn spotless:apply`.

          intellij-style.xml (repo root) is a real IntelliJ-exported Eclipse formatter profile,
          patched to fix several `alignment_for_*` properties that were exported as "never wrap"
          (0) - verified empirically against this project's actual checkstyle.xml/pmd-ruleset.xml
          via a real `mvn compile` run before being trusted (see git history / PR description for
          the specific LineLength and OperatorWrap failures this fixed).
        -->
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-plugin.version}</version>
        <configuration>
          <lineEndings>PRESERVE</lineEndings>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <eclipse>
              <file>${project.basedir}/intellij-style.xml</file>
            </eclipse>
            <removeUnusedImports></removeUnusedImports>
          </java>
          <skip>${skipTests}</skip>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>process-sources</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${pmd-plugin.version}</version>
        <configuration>
          <!--
            compileSourceRoots (not sourceDirectories - that parameter doesn't exist on this
            plugin's pmd/check goals and was silently ignored here for a long time; confirmed via
            the official parameter list at
            https://maven.apache.org/plugins-archives/maven-pmd-plugin-3.28.0/pmd-mojo.html) is the
            real parameter for main-source scoping. It has always defaulted to
            ${project.compileSourceRoots} anyway, so this override was a no-op even under the wrong
            name - kept explicit here for clarity now that the name is correct.
          -->
          <compileSourceRoots>
            <compileSourceRoot>${project.build.sourceDirectory}</compileSourceRoot>
          </compileSourceRoots>
          <testSourceRoots>
            <testSourceRoot>${project.build.testSourceDirectory}</testSourceRoot>
          </testSourceRoots>
          <excludeRoots>
            <excludeRoot>${project.build.directory}/generated-sources/openapi/src/gen/java</excludeRoot>
          </excludeRoots>
          <!--
            includeTests=true here does NOT mean test code gets the same rules as main: it just
            makes both source roots available for PMD to scan in this one execution.
            pmd-ruleset.xml and pmd-ruleset-tests.xml each carry their own <exclude-pattern> (main
            excludes test files, tests excludes main files), so which rules apply to which source
            root is governed by that file-pattern scoping, not by having two separate executions.
            A genuine two-execution split (one config for main, another for test) was tried first
            and doesn't work: the check goal forks its own analysis via the pmd goal, and that fork
            always uses this plugin-level default <configuration>, ignoring per-<execution>
            overrides entirely (confirmed with `mvn -X pmd:check@<id>` showing the forked pmd goal
            still using this block's compileSourceRoots/rulesets no matter which execution
            triggered it) - a real limitation of maven-pmd-plugin 3.28.0's check-forks-pmd
            architecture, not a configuration mistake.
          -->
          <includeTests>true</includeTests>
          <rulesets>
            <ruleset>pmd-ruleset.xml</ruleset>
            <ruleset>pmd-ruleset-tests.xml</ruleset>
          </rulesets>
          <skip>${skipTests}</skip>
          <failOnViolation>true</failOnViolation>
        </configuration>
        <executions>
          <execution>
            <!--
              process-classes, not process-sources (where spotless/checkstyle sit): PMD needs
              target/classes on its auxclasspath to resolve types, and process-sources runs before
              compile, so it would get none. Under PMD 7.17.0 that starved auxclasspath is not
              merely less precise, it produces false positives - ImplicitFunctionalInterface fires
              on GrantCapableMapper because its unresolved supertype hides a second abstract
              method, and UnnecessaryWarningSuppression fires on the two
              @SuppressWarnings("PMD.CompareObjectsWithEquals") sites because PMD cannot see that
              the rule they suppress would otherwise trigger. Those 3 violations broke CI on every
              fresh checkout while passing locally on any tree with leftover target/classes; the
              pre-3.28.0 plugin (PMD 7.7.0) happened not to flag them, which is why the binding
              looked fine until then. Anything later than process-classes works equally well for
              PMD, but this phase keeps the failure adjacent to its process-sources siblings.
            -->
            <id>pmd-check</id>
            <phase>process-classes</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${checkstyle-plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>checkstyle.xml</configLocation>
          <sourceDirectories>
            <sourceDirectory>${project.build.sourceDirectory}</sourceDirectory>
          </sourceDirectories>
          <includeTestSourceDirectory>false</includeTestSourceDirectory>
          <propertyExpansion>checkstyle.methodname.format=^[a-z][a-zA-Z0-9]*$</propertyExpansion>
          <skip>${skipTests}</skip>
          <failOnViolation>true</failOnViolation>
          <violationSeverity>warning</violationSeverity>
        </configuration>
        <executions>
          <execution>
            <id>javadoc-tag-check</id>
            <phase>process-sources</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
          <execution>
            <!--
              Same checkstyle.xml ruleset as the main execution above, run against
              src/test/java. The only difference is the MethodName pattern: this execution's
              propertyExpansion loosens it to allow the project's
              methodUnderTest_scenario_expectedResult test-naming convention, which the
              default camelCase-only pattern used for src/main/java would otherwise reject.
            -->
            <id>test-checkstyle-check</id>
            <phase>process-test-sources</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <sourceDirectories combine.self="override">
                <sourceDirectory>${project.build.testSourceDirectory}</sourceDirectory>
              </sourceDirectories>
              <includeTestSourceDirectory>true</includeTestSourceDirectory>
              <propertyExpansion>checkstyle.methodname.format=^[a-z][a-zA-Z0-9]*(_[a-zA-Z0-9]+)*$</propertyExpansion>
              <skip>${skipTests}</skip>
              <failOnViolation>true</failOnViolation>
              <violationSeverity>warning</violationSeverity>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!--
          effort=Max/threshold=Low with no include filter is "all its checkers" - full detector
          set, lowest confidence bar. A first discovery-mode run (goal spotbugs, no exclude
          filter) found 490 findings; triage (see STATIC_ANALYSIS_POLICY.md's SpotBugs decision
          register) showed every one was either noise (EI_EXPOSE_REP/REP2 on plain DTO getters),
          a SpotBugs/Java-21-record-pattern false positive, or an already-documented deliberate
          decision (the checkstyle.xml IllegalCatch degrade-gracefully catches) - all now covered
          by spotbugs-exclude.xml. What's left after filtering is a genuine regression guard, so
          this runs as a hard gate (goal check, failOnViolation=true) like Checkstyle/PMD.

          Bound to process-test-classes, not process-classes like maven-pmd-plugin above: PMD
          analyzes source (AST) and only needs target/classes on its auxclasspath for type
          resolution, so process-classes works even though it scans test sources too. SpotBugs
          analyzes real bytecode, and target/test-classes does not exist until after
          test-compile - an earlier phase would silently skip test-code detectors while reporting
          a clean run.

          The nested <plugins> below loads FindSecBugs, whose SECURITY-category detectors (XXE,
          injection, crypto misuse, ...) plain SpotBugs does not ship - see
          STATIC_ANALYSIS_POLICY.md's SpotBugs decision register for the triage of what it found
          here. It runs under the same effort/threshold/excludeFilterFile as the rest, so no
          separate include/exclude file.
        -->
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs-plugin.version}</version>
        <configuration>
          <effort>Max</effort>
          <threshold>Low</threshold>
          <includeTests>true</includeTests>
          <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
          <skip>${skipTests}</skip>
          <failOnError>true</failOnError>
          <plugins>
            <plugin>
              <groupId>com.h3xstream.findsecbugs</groupId>
              <artifactId>findsecbugs-plugin</artifactId>
              <version>${findsecbugs-plugin.version}</version>
            </plugin>
          </plugins>
        </configuration>
        <executions>
          <execution>
            <id>spotbugs-check</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

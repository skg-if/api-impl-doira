####
# This Dockerfile is used to build a container that runs the Quarkus application in JVM mode.
#
# Before building the container image, build the application:
#
# mvn package
#
# Then build the image:
#
# docker build -f src/main/docker/Dockerfile.jvm -t puma-skg-if-api-jvm .
#
# Then run the container:
#
# docker run -i --rm -p 8080:8080 puma-skg-if-api-jvm
#
# Optional: identify this API to Crossref's "polite pool" for better rate limits/uptime, by
# setting CROSSREF_MAILTO - Quarkus/SmallRye Config maps it onto the crossref.mailto property
# (application.properties) with no other change needed:
#
# docker run -i --rm -p 8080:8080 -e CROSSREF_MAILTO=you@example.org puma-skg-if-api-jvm
#
###

# Keep this JDK major in step with pom.xml's <maven.compiler.release>, this repo's single
# source of truth for the Java version. A Dockerfile cannot read pom.xml at parse time, so
# ToolchainVersionConsistencyTest fails the build if the two drift apart. Written as a literal
# rather than an ARG because Dependabot's docker manager does no ARG interpolation - an
# ${...} in the image reference makes it skip this line silently, which would leave the
# published image's CVE patch level unmonitored.
FROM registry.access.redhat.com/ubi9/openjdk-21:1.24

ENV LANGUAGE='en_US:en'

# Four distinct layers so unchanged library/runtime layers can be cached separately
COPY --chown=185 target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185 target/quarkus-app/*.jar /deployments/
COPY --chown=185 target/quarkus-app/app/ /deployments/app/
COPY --chown=185 target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER 185
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

ENTRYPOINT [ "/opt/jboss/container/java/run/run-java.sh" ]

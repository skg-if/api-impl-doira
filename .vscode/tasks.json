{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "quarkus:dev",
      "type": "shell",
      "command": "./mvnw",
      "args": [
        "quarkus:dev",
        "-Dquarkus.test.continuous-testing=disabled",
        "-Dquarkus.console.enabled=false",
        "-Ddebug=false"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^never-matches$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[io\\.quarkus\\]",
          "endsPattern": "Listening on: http://0\\.0\\.0\\.0:8080"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}
